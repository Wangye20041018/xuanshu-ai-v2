entIdLabel:"Agent ID",workspaceLabel:"工作区",channelsTitle:"频道概览",channelsDescription:"通过连接以下频道，可以与当前 Agent 直接建立通信。",mainAccount:"主账号",noChannels:"这个 Agent 还没有分配任何频道。",channelsManagedInChannels:"该 Agent 已关联频道类型，具体账号绑定请在 Channels 页面查看。",channelNotLinked:"未连接",linkedChannelCount:"已连接: {{count}}",bindChannel:"绑定",channelBound:"已绑定",linkChannel:"去连接",memoryTitle:"记忆文件",memoryDescription:"查看该 Agent 工作区中的记忆文件和每日日志。",coreDocsTitle:"核心文档",dailyLogsTitle:"每日日志",loadingBundle:"正在加载记忆文件...",loadBundleError:"加载记忆文件失败",tabs:{overview:"概览",heartbeat:"心跳",capabilities:"工具与技能",mobileRemote:"手机远程",workspace:"文件"},saveCapabilities:"保存工具/技能",capabilitiesUnsavedHint:"有未保存变更",capabilitiesDescription:"为该 Agent 配置工具与技能启用状态。保存会触发 Gateway 重启生效。",heartbeatTitle:"心跳",heartbeatDescription:"为该 Agent 配置轻量的定期巡检。",heartbeatEnableLabel:"启用心跳",heartbeatEnableHelp:"关闭后将停止心跳巡检。",heartbeatEveryLabel:"频率",heartbeatEvery30m:"每 30 分钟",heartbeatEvery1h:"每 1 小时",heartbeatEvery2h:"每 2 小时",heartbeatTargetLabel:"消息投递",heartbeatTargetNone:"不外发（静默运行）",heartbeatTargetLast:"发送到最近会话",heartbeatEconomyLabel:"省流模式",heartbeatEconomyHelp:"开启后会更省消耗，适合日常巡检。",heartbeatActiveHoursLabel:"活跃时段",heartbeatActiveHoursOff:"不限制",heartbeatActiveHoursAllDay:"全天（00:00-24:00）",heartbeatActiveHoursWorkday:"工作时段（09:00-22:00）",heartbeatActiveHoursCustom:"自定义",heartbeatStartLabel:"开始（HH:MM）",heartbeatEndLabel:"结束（HH:MM）",heartbeatSave:"保存心跳配置",heartbeatUnsavedHint:"心跳配置有未保存修改",heartbeatSavedHint:"心跳配置已是最新",loadingCapabilities:"正在加载工具与技能目录...",toolsTitle:"工具",toolsDescription:"控制该 Agent 可用工具。",skillsTitle:"技能",skillsDescription:"当技能全部启用时，不写入 skills 字段（默认模式）。",capabilityTabs:{tools:"工具",skills:"技能"},skillDisabledReasonAlways:"该技能为始终启用，无法手动切换。",skillDisabledReasonAllowlist:"被 allowlist 策略拦截。",skillDisabledReasonIneligible:"当前环境暂不满足运行条件，但你仍可先启用，条件满足后即可生效。",skillDisabledReasonDisabled:"该技能被运行时策略禁用。",unsavedChangesTitle:"存在未保存修改",unsavedChangesMessage:"工具/技能配置尚未保存，确定直接关闭吗？",closeWithoutSaving:"不保存并关闭",states:{exists:"可读取",missing:"缺失",pending:"待生成"},empty:{noBundle:"未找到该 Agent 的记忆文件。",noDailyLogs:"暂无日志。Agent 在记录对话要点或接近 token 上限触发记忆刷新时，会自动创建每日日志。"},docDescriptions:{identity:"记录 Agent 名称、头像、Emoji 等身份信息。",soul:"定义 Agent 人设、语气、边界和行为风格。",agents:"定义 Agent 的执行规范与工作约束。",user:"记录用户画像、偏好和交互约定。",tools:"记录工具使用策略、限制和最佳实践。",memory:"长期核心记忆，保存稳定事实和关键决策。"},hints:{memoryNotYetCreated:"该文件不会自动创建，而是由 Agent 在对话过程中自主生成。与 Agent 聊天即可逐步积累记忆，Agent 会将关键信息写入此文件。",dailyLogsAutoCreated:"Agent 记录对话要点时自动创建。"}},toast:{agentHeartbeatUpdated:"已更新 Agent 心跳配置",agentHeartbeatUpdateFailed:"更新 Agent 心跳配置失败：{{error}}",agentHeartbeatInvalidTimeRange:"开始和结束时间不能相同",channelBound:"{{channel}} 已绑定到 Agent"},agentDetailDialog:{title:"{{name}}",description:"查看当前 Agent 的基本信息，以及已经分配给它的频道账号。",nameLabel:"Agent 名称",saveName:"保存",agentIdLabel:"Agent ID",agentTypeLabel:"Agent 类型",defaultAgentValue:"默认 Agent",customAgentValue:"自定义 Agent",channelsTitle:"频道",channelsDescription:"通过连接以下频道，可以与当前 Agent 直接建立通信。",mainAccount:"主账号",channelsManagedInChannels:"该 Agent 已关联频道类型，具体账号绑定请在 Channels 页面查看。",noChannels:"这个 Agent 还没有分配任何频道。",channelNotLinked:"未连接",linkedChannelCount:"已连接: {{count}}",bindChannel:"绑定",channelBound:"已绑定",linkChannel:"去连接"},tabs:{myAgents:"专家管理",agentStore:"专家商店",interconnectedAgents:"互联 Agent"},interconnectedAgents:{cherry:{name:"AI Cherry",description:"运行在 PC 上的智能语音助手，基于 Intel OpenVINO 本地推理引擎提供 PC 端感知与操控能力",status:{not_installed:"未安装",downloaded:"待安装",stopped:"待启动",starting:"启动中…",running:"运行中",closing:"关闭中…",broken:"安装已损坏"},actions:{download:"下载",downloading:"下载中…",cancelDownload:"取消下载",install:"安装 Cherry",installing:"安装中…",start:"启动 Cherry",startShort:"启动",close:"关闭 Cherry",closeShort:"关闭",starting:"启动中…",closing:"关闭中…",refresh:"刷新",updateNow:"立即更新",skipUpdate:"暂不更新",processing:"处理中…",reDownload:"重新下载"},hints:{downloaded:"安装包已就绪，点击安装即可开始。",broken:"安装已损坏。请重新下载并安装 Cherry。",starting:"正在等待 Cherry 建立 ACP 连接…",running:"Cherry 是一个 PC 语音助手，当前正在运行。"},capabilities:{title:"核心能力",systemControl:{title:"系统操控",desc:"200+ 条本地指令：打开/关闭应用（60+ 第三方应用）、音量/亮度调节、窗口管理、截屏录屏、电源控制（关机/重启/锁屏）、投影模式切换、系统设置开关（暗色主题、勿扰模式、桌面图标等）"},fileOps:{title:"文件操作",desc:"读写文件、目录浏览、文件搜索，支持读取用户本地文件"},voice:{title:"语音识别",desc:"本地离线 ASR，支持短指令快速识别（SenseVoice）和长语音高精度识别（Qwen3-ASR），无需网络"},coding:{title:"编程执行",desc:"终端命令执行、Python 代码运行（自动环境检测与安装）"},smartRouting:{title:"智能路由",desc:"基于 Intel OpenVINO 本地推理引擎（支持 CPU/GPU/NPU），5 维评分模型实时判断用户意图，自动区分本地指令执行与云端大模型对话"}}}},shop:{install:"安装",installing:"安装中...",installBusy:"当前已有安装任务正在进行。",viewDetails:"查看详情",detailTitle:"Agent 详情",repeatInstallHint:"支持重复安装，不会覆盖已有 Agent",byAuthor:"作者：{{author}}",publishedAt:"发布时间",more:"更多",installPhases:{idle:"准备安装",downloading:"正在下载模板",extracting:"正在解压压缩包",validating:"正在校验工作区文件",copying:"正在复制工作区文件",preparing:"正在准备运行环境",completed:"安装完成",error:"安装失败"},sections:{description:"描述",introduction:"使用场景"},empty:{title:"暂无 Agent",description:"请稍后再来查看新的 Agent。"},completionDialog:{title:"安装成功!",description:"{{name}} 已成功添加到您的列表中",goHome:"去首页聊天",stay:"留在 Agent 中心"},toast:{installed:"已安装到 {{name}}",installFailed:"安装 Agent 失败：{{error}}",installInProgress:"当前已有安装任务正在进行。",loadDetailFailed:"加载 Agent 详情失败：{{error}}",installTimeout:"安装超时，请检查网络后重试。"}},managedStatus:{loading:"Managed: 检查中...",ready:"Managed: 已安装",installing:"Managed: 安装中",error:"Managed: 安装失败",notInstalled:"Managed: 未安装",disabled:"Managed: 暂不可用"}},setup:{steps:{provider:{title:"模型选择",description:"请选择模型"}},model:{label:"选择模型",loading:"正在加载模型列表...",empty:"暂无可用模型",retry:"重试",error:"获取模型列表失败",saved:"已保存模型：{{model}}",saveError:"保存模型失败",savedMessage:"已保存模型：{{model}}"}},common:{toast:{modelSwitched:"模型已切换：{{from}} → {{to}}",modelSwitchFailed:"切换模型失败（{{model}}）：{{error}}",restoreModel:"恢复"},sidebar:{aiVideo:"AI 视频",logout:"退出登录",creditsTooltip:{newUser:"新用户注册登录：送 1000 积分",newUserSuffix:"（1 年内有效）",dailyLogin:"每日登录：领 200 积分",dailyLoginSuffix:"（当日 24 点清零）",insufficient:"积分不足：随时充值购买",insufficientSuffix:"（规则以充值页为准）",viewBilling:"查看积分账单",refresh:"刷新",types:{dailyCheckin:"每日签到积分",plan:"套餐内积分",pack:"积分加量包积分",signup:"新用户注册积分",teamSeat:"团队套餐积分",other:"其他积分"}}},session_expired:{title:"登录已过期",description:"登录信息已失效，请重新登录以继续使用。",button:"重新登录"}},settings:{securityCenter:{cardTitle:"安全防护",cardDescription:"保护您的电脑和重要文件，防止 OpenClaw 误删数据或执行危险操作。",windowsOnly:"仅 Windows",openDetails:"查看详情",summary:{modeLabel:"防护状态",modeEnabled:"已开启",modeOff:"已关闭",systemPathsLabel:"系统保护目录",customPathsLabel:"自定义保护目录",commandGroupsLabel:"拦截规则组",countValue:"{{count}} 项",protectedValue:"已保护",unprotectedValue:"未保护",detailHint:"详情中可调整拦截模式或维护自定义保护目录。"},interceptionMode:{label:"危险操作拦截",description:"开启后，将强制阻止 OpenClaw 执行任何高风险操作或修改受保护的文件。",block:"开启拦截",off:"关闭拦截",restartTitle:"重启网关以应用更改",restartDescription:"修改安全拦截模式需要重启网关才能生效，当前进行中的任务可能会被中断。是否确认继续？",restartConfirm:"确认并重启",restartCancel:"取消"},sectionTitles:{highRisk:"禁止执行的高风险操作",fileCommands:"受限的文件操作指令",wrappers:"防绕过机制",systemPaths:"默认受保护的系统目录"},sectionDescriptions:{highRisk:"",fileCommands:"",wrappers:"",systemPaths:""},ruleGroups:{destructive:"破坏类",delete:"删除类",move:"移动类",write:"写入类",permissions:"提权类",registry:"注册表",services:"系统服务",network:"网络配置",disk:"磁盘操作",downloadExecute:"下载执行",wrappers:"环境命令"},protectedPaths:{label:"我保护的重要文件夹",description:"将不想被 OpenClaw 修改或删除的文件夹添加到这里。",addFolder:"添加文件夹",dedupeHint:"父目录会自动覆盖其子目录，避免重复规则。",empty:"暂未添加自定义受保护目录。",added:"已添加受保护目录",addFailed:"添加受保护目录失败",removed:"已移除受保护目录",duplicateIgnored:"该目录已在保护范围内",removeAria:"移除受保护目录 {{path}}"}},agentMemoryReadonly:{cardTitle:"Agent 记忆",cardDescription:"按 Agent 查看人格与记忆相关 Markdown 文件",memoryToggle:{label:"内置 Memory",description:'关闭后会向 openclaw.json 写入 plugins.slots.memory = "none"。',enabledSuccess:"已启用内置 memory",disabledSuccess:"已关闭内置 memory",loadFailed:"加载内置 memory 状态失败",saveFailed:"更新内置 memory 状态失败"},openDialog:"打开记忆详情",dialogTitle:"Agent 记忆详情",dialogDescription:"在弹窗中按 Agent 查看配置、核心文档与每日日志",title:"Agent 记忆只读面板",description:"默认折叠，展开后按 Agent 切换查看配置与记忆文档",expand:"展开",collapse:"收起",agentListTitle:"Agent 列表",agentListDescription:"按 openclaw.json 原顺序展示",overviewTitle:"Agent 配置概览",coreDocsTitle:"核心文档",dailyLogsTitle:"每日日志",loading:{bundle:"正在加载 Agent 文档..."},states:{exists:"可读取",missing:"缺失（空态）",pending:"待生成"},empty:{noAgents:"未发现可用 Agent，请检查 openclaw.json。",noDailyLogs:"该 Agent 暂无每日日志文件。"},errors:{loadAgentList:"加载 Agent 列表失败",loadAgentBundle:"加载 Agent 文档失败"},labels:{agentId:"Agent ID",workspace:"工作区",model:"模型",sandboxMode:"沙箱模式",toolsAllowCount:"允许工具数",toolsDenyCount:"拒绝工具数",notSet:"未设置"},docDescriptions:{identity:"记录 Agent 名称、头像、Emoji 等身份信息。",soul:"定义 Agent 人设、语气、边界和行为风格。",agents:"定义 Agent 的执行规范与工作约束。",user:"记录用户画像、偏好和交互约定。",tools:"记录工具使用策略、限制和最佳实践。",memory:"长期核心记忆，保存稳定事实和关键决策。"},hints:{memoryNotYetCreated:"该文件不会自动创建，而是由 Agent 在对话过程中自主生成。与 Agent 聊天即可逐步积累记忆，Agent 会将关键信息写入此文件。",dailyLogsAutoCreated:"暂无日志。Agent 在记录对话要点或接近 token 上限触发记忆刷新时，会自动创建每日日志。"}}},channels:{health:{reasons:{gateway_recovering:"网关正在从最近的 RPC 超时中恢复。",gateway_application_stuck:"网关连接仍在线，但关键运行时 RPC 已经无响应。"}},dialog:{feishuModeBadge:"扫码创建 / 手动关联",retryCreateBot:"重新生成二维码",createFeishuBot:"新建飞书机器人",feishuExistingDescription:"查看并更新当前账号对应的飞书机器人配置。",feishuExistingHelpTitle:"当前机器人配置",feishuCreateDescription:"通过官方扫码流程创建新的飞书机器人，并在完成后自动写回应用配置。",feishuCreateInstructions:["选择“新建飞书机器人”后，点击下方按钮生成二维码","使用飞书客户端扫码，并按飞书提示完成机器人创建","创建成功后，应用会自动写入 App ID / App Secret 并刷新渠道状态","如果你已经有现成的 App ID / App Secret，请切换到“关联已有机器人”模式"],feishuModes:{create:{title:"新建飞书机器人",description:"扫码创建新的飞书机器人，并自动接入当前渠道。"},manual:{title:"关联已有机器人",description:"手动填写现有 App ID / App Secret，沿用当前配置流程。"}},feishuCreateStates:{waiting_scan:"请使用飞书扫码创建机器人",creating_bot:"已扫码，正在创建机器人",applying_config:"正在写入飞书配置",restarting:"正在刷新渠道连接",completed:"创建成功，正在更新渠道状态",failed:"创建失败，请重试"},feishuHelpModes:{create:{summary:"扫码创建新的飞书机器人，完成后应用会自动写回生成的凭据。"},manual:{summary:"如果你已经有 App ID 和 App Secret，就使用这个模式关联现有机器人。"}},feishuHelpExisting:{summary:"这里仅维护当前机器人的配置。如果要新建另一个飞书机器人，请返回频道列表使用新增入口。"},qqbotModeBadge:"扫码创建 / 手动关联",createQQBotBot:"新建 QQ 机器人",qqbotCreateDescription:"通过官方扫码流程创建/绑定 QQ 机器人，并在完成后自动写回应用配置。",qqbotCreateInstructions:["选择“新建 QQ 机器人”后，点击下方按钮生成二维码","使用手机 QQ 扫码，并按提示完成机器人绑定","绑定成功后，应用会自动写入 App ID / Client Secret 并刷新渠道状态","如果你已经有现成的 App ID / Client Secret，请切换到“关联已有机器人”模式"],qqbotModes:{create:{title:"新建 QQ 机器人",description:"扫码创建/绑定 QQ 机器人，并自动接入当前渠道。"},manual:{title:"关联已有机器人",description:"手动填写现有 App ID / Client Secret，沿用当前配置流程。"}},qqbotCreateStates:{waiting_scan:"请使用手机 QQ 扫码绑定机器人",creating_bot:"已扫码，正在绑定机器人",completed:"绑定成功，正在更新渠道状态",failed:"绑定失败，请重试"},qqbotHelpModes:{create:{summary:"扫码创建/绑定 QQ 机器人，完成后应用会自动写回生成的凭据。"},manual:{summary:"如果你已经有 App ID 和 Client Secret，就使用这个模式关联现有机器人。"}}},meta:{feishu:{description:"通过飞书官方推出的 OpenClaw 插件连接飞书/Lark 机器人",instructions:["前往 飞书开放平台 (open.feishu.cn) 并创建企业自建应用","在应用详情页获取 App ID 和 App Secret 并填入下方","确保应用已开通“机器人”能力","在“事件与回调”里把订阅方式设置为“长链接”，并至少订阅消息接收和卡片交互相关事件","保存配置后，根据网关提示完成机器人创建，并发布飞书应用版本","详细步骤请参考飞书官方文档"]}}},videoWorkbench:{header:{badge:"Video Workbench",title:"AI 视频工作台",pageTitle:"AI视频生成",generationQueue:"生成队列",newTask:"新任务",history:"历史记录"},navigation:{label:"快速定位",currentDraft:"当前草稿",runningTask:"运行中任务"},inspiration:{title:"开启你的视频创作，即刻造梦",description:"先选一个预设提示词快速起步，再在下方编辑区补充素材、比例、时长和镜头语言。",presetLabel:"预设提示词",expand:"展开更多模板",collapse:"收起模板",compactHint:"上方已进入执行中的任务卡，展开后仍可快速切换新的预设提示词。"},presetCards:{cyberpunkCity:{title:"赛博摩托",subtitle:"科幻速度 / 追车镜头",prompt:"8K超高清，60fps赛博朋克追车镜头。未来感摩托车车身锐利，金属质感搭配霓虹光效，车轮流转蓝紫光轨，仪表盘全息投影闪烁。骑手疾驰于高科技网格街道，路面泛起流动光波纹，车灯强光撕裂夜色。镜头紧贴车身高速跟拍，动态模糊与尾焰粒子强化速度感。两侧全息广告与冷峻建筑营造压迫氛围。运镜流畅无抖动，光影反射严格符合物理规律，全程无循环动画，主体与机车结构绝对一致，呈现硬核科幻速度美学。"},wuxiaAction:{title:"武侠雨战",subtitle:"叙事动作 / 暴雨群战",prompt:"8K超高清，60fps电影级武侠大片。暴雨江南古街积水倒映暖黄灯火，黑金战甲侠客自屋顶凌空跃入黑衣敌阵，长剑破雨劈砍格挡，落地旋身连续击退数人，水花飞溅、衣袂翻飞严格遵循物理规律。镜头自高空俯推切入中景，环绕跟拍剑刃特写后快速推拉展现群战，最后缓慢拉远定格收剑背影。全程叙事连贯无循环，次世代PBR写实渲染，丁达尔雨丝与冷峻光影交织，主体绝对一致，无变形穿模水印。"},productShowcase:{title:"商业产品",subtitle:"质感光影 / 产品大片",prompt:"8K超高清，60fps高端产品广告大片。画面中央为设计感十足的产品主体，标签锐利清晰，置于高反光深色舞台台面。瓶身伴随微幅物理震动，周围光线如涟漪般在反射表面流转。背景抽象渐变能量光束交错穿梭，营造蓄势待发的视觉张力。镜头自侧方疾速推入特写，凸显材质通透感与硬朗轮廓，随后匀速拉远展露整体气场。柔光与硬光精准交替，色彩浓郁纯正不偏色。全程主体居中稳定，光影波动自然，无循环无水印，尽显现代商业质感。"},natureBreeze:{title:"海岸航拍",subtitle:"自然风光 / 沉浸航拍",prompt:"8K超高清，60fps沉浸式航拍大片。镜头自厚重云层疾速俯冲，掠过草坡野花与黑色崖壁，直逼壮阔北欧海岸。悬崖边缘人影缓步向前，成群海鸥迎面掠过镜头，海浪猛烈拍岸，草叶随风摇曳。丁达尔阳光穿透云隙，光影随地形快速流转，明暗对比极具视觉冲击。运镜全程平滑前推无卡顿，自然景观与人物动势连贯统一。画面无循环、无抖动变形，色彩还原真实，呈现史诗级自由氛围。"}},composer:{none:"无",promptPlaceholder:"描述你的想法",context:{title:"当前创作上下文",agent:"扩写 · {{agent}}",model:"模型 · {{model}}",references:"{{count}} 个参考素材",frames:"{{count}} 个关键帧",uploadingAssets:"{{count}} 个素材上传中",failedAssets:"{{count}} 个素材上传失败",expandReady:"可撤回最近一次扩写",expandStale:"扩写后已修改文案"},actions:{upload:"上传",referenceAsset:"引用素材",history:"历史",revertExpand:"撤回扩写",expanding:"扩写中...",expand:"灵感扩写",moreControls:"更多控制",lessControls:"收起控制",generating:"生成中...",loadingModels:"模型加载中...",generate:"生成"},fields:{videoModel:"视频模型",aspectRatio:"比例",duration:"时长"},model:{loading:"正在加载视频模型...",noModels:"暂无可用视频模型",missing:"尚未选择模型",available:"当前可用 {{count}} 个视频模型"},status:{saving:"正在保存草稿..."},capability:{images:"图片 {{count}} / {{max}}",videos:"视频 {{count}} / {{max}}",audios:"音频 {{count}} / {{max}}",duration:"最长 {{max}}s"},referenceMenu:{empty:"先上传参考素材后再引用。"},agent:{currentAgentTitle:"当前扩写 Agent：{{agent}}",selectAgentTitle:"选择扩写 Agent：{{agent}}",menuTitle:"扩写 Agent",noAgents:"当前没有可用 planner agent，将自动走 AI LLM / 本地兜底。"}},agent:{autoSelect:"自动选择",autoSelectHint:"优先尝试 video-planner，无可用 agent 时走 AI LLM / 本地兜底。"},auth:{loginRequired:"请先登录账号后再执行扩写或生成。"},toast:{expandFailed:"灵感扩写失败",expandPersistFailed:"扩写结果已记录到任务，但本地编辑器未能同步，请重新扩写或刷新任务后重试。",submitFailed:"视频生成提交失败",revisionConflict:"任务状态已变化，请确认后重新提交",saveDraftFailed:"草稿保存失败",cancelFailed:"取消失败",retryFailed:"重试失败",syncArtifactsFailed:"同步产物失败",referenceLimitReached:"参考素材数量已达上限：{{kinds}}",referenceTypeNotSupported:"当前视频模型不支持：{{kinds}}",framesNotSupported:"当前视频能力暂不支持首尾帧。",durationNotSupported:"当前仅支持不超过 {{max}}s 的生成时长。",videoModelRequired:"请先选择视频模型后再生成。",videoModelsLoadFailed:"加载视频模型失败。",assetUploadPending:"请等待素材上传完成后再生成。",assetUploadFailed:"素材上传失败。",assetUploadFailedWithName:"素材 {{name}} 上传失败。",assetUploadRetryUnavailable:"原始本地文件已不可用，请重新选择素材。",assetUploadFailedBeforeGenerate:"存在上传失败的素材，请重试或重新选择后再生成。",eventChannelError:"事件通道异常，请检查桌面事件桥接",eventChannelErrorWithName:"事件通道异常：{{eventName}}",exportArtifactSuccess:"视频已保存到您选择的文件夹。",exportArtifactFailed:"保存失败：{{message}}",exportArtifactFailedFallback:"未知错误",stopGenerationFailed:"停止生成失败，请重试"},durationOption:"{{seconds}}s",durationUnit:"秒",generationQueue:{title:"正在生成",empty:"暂无生成中的任务"},resultProgress:{stageSubmit:"提交任务",stageGenerate:"生成视频",stageSync:"同步结果",submitting:"正在提交生成任务",queued:"任务已进入队列，等待资源分配",generating:"正在生成视频",syncing:"正在同步生成结果",preparing:"正在准备生成任务"},creativeRun:{execution:{videoProcessing:"视频生成中",processing:"处理中"},videoPreview:"视频预览",videoPreviewSubtitle:"实时预览生成的视频内容",timeline:{userIntent:"你的原始创意",script:"OpenClaw 剧本整理",videoExecution:"系统开始视频生成",videoResult:"视频已生成完成",videoError:"视频生成未完成",videoReferenceBadge:"附带视频参考",autoMusicBadge:"已自动配乐",noVideoModel:"未选择模型",detail:{assets:"素材输入",none:"仅文本创意",params:"生成参数",imageReference:"{{count}} 张图片参考",videoReference:"{{count}} 条视频参考",hasFirstFrame:"含首帧",hasLastFrame:"含尾帧"},format:{justNow:"刚刚",minutesAgo:"{{count}} 分钟前",monthDay:"{{month}}月{{day}}日 {{time}}"}},workspace:{videoTitle:"视频结果",videoWithReference:"当前任务附带原始视频参考，最终生成阶段会直接透传这些素材。",videoNoReference:"当前任务未附带原始视频参考，视频将基于整理后的创意和已上传素材生成。",scriptTitle:"剧本整理"},steps:{idea:"原始创意",script:"剧本整理",video:"视频生成"},jumpToLatest:"回到最新进度"},historyDrawer:{title:"历史任务",description:"查看最近任务与已完成的视频，可将成品导出到任意文件夹。",tabs:{history:"历史任务",assets:"成品视频"},groups:{running:"运行中",recent:"最近结果",drafts:"草稿"},emptyHistory:"还没有历史任务。",emptyOutputs:"暂无已完成视频。生成成功后将在此显示，可预览并导出。",openTask:"打开任务",saveVideoAs:"另存为…",lastModified:"上次修改 {{time}}",back:"返回",cancel:"取消",deleteTask:"删除",deleteConfirmTitle:"删除任务",deleteConfirmMessage:"将永久删除「{{title}}」的任务记录，此操作无法撤销。",saveBeforeDelete:"该任务包含已生成的视频，如需保留请先保存。",saveVideo:"保存视频",savingVideo:"保存中…",deleteSuccess:"任务已删除",deleteFailed:"删除任务失败：{{error}}"},detail:{backToStudio:"返回创作页",assistantTitle:"视频生成助手",submittedPrompt:"本次提交文案",progressTitle:"执行进度",previewTitle:"结果预览",actionsTitle:"任务操作",loadingTask:"正在加载任务详情...",planningPending:"正在整理规划并准备生成链路。",eta:{remaining:"预计剩余 {{duration}}"},progress:{submitting:"正在向 provider 提交本次生成请求。",queued:"provider 已接收任务，正在排队等待执行。",running:"provider 正在生成结果，进度会持续在这里更新。",syncingArtifacts:"远端生成已完成，正在把产物同步回工作台。",failed:"这次生成在完成前终止了，请检查错误后再决定是否重试。",cancelled:"这次生成在完成前已被取消。"}},taskCard:{unnamedTask:"未命名视频任务",waiting:"等待进一步处理",meta:{updatedAt:"最近更新 {{time}}",retrying:"已重试 {{count}} 次",warnings:"{{count}} 条提示",outputs:"{{count}} 个结果"},actions:{cancelling:"取消中...",cancel:"取消",stopGeneration:"停止生成",retrying:"重试中...",retry:"重新生成",syncingArtifacts:"同步中...",syncArtifacts:"重试同步产物",regenerate:"再生成一版",download:"下载",savingVideo:"保存中…",delete:"删除"},actionHints:{running:"当前任务正在执行中，你可以在这里等待结果，或停止这次生成。",syncArtifacts:"远端生成已完成。可以重试同步产物到工作台，无需重新生成。",failed:"这次生成未完成。你可以直接在这个任务上重试，或返回创作页修改后再生成。",succeeded:"结果已经准备好。可以直接下载，也可以基于同一创意再生成一个新版本。"},showWarnings:"展开提示",hideWarnings:"收起提示",providerTaskId:"任务 · {{id}}",remoteJobId:"远端任务 · {{id}}",retryHintWithDelay:"已自动重试 {{count}} 次，{{delaySeconds}}s 后继续轮询",retryHintWithoutDelay:"已自动重试 {{count}} 次",warningsTitle:"结果包含提示",progressSteps:{directing:"导演构思中",assets:"素材载入中",rendering:"视频渲染中"}},planning:{title:"规划摘要",presetSource:"预设来源",unselected:"未选择",planSource:"规划来源",shotCount:"镜头数量",empty:"尚未生成规划摘要。",source:{openclaw:"OpenClaw",aiLlm:"AI LLM",fallback:"本地兜底",unplanned:"未规划"},showDetails:"展开详情",hideDetails:"收起详情"},resultPreview:{errorCode:"错误码：{{code}}",errorDetailsLabel:"错误详情",waitingForArtifact:"任务已完成，等待产物同步。",artifactProcessing:"远端生成已完成，正在同步产物到工作台。",empty:"暂无结果",generatedResultAlt:"生成结果",openRemoteUrl:"在浏览器中打开",remotePreview:"远程预览（本地下载失败）",remoteExpired:"远程预览已过期，请重试同步",fallbackError:"视频生成失败"},steps:{input:"输入",plan:"规划",submit:"提交",generate:"生成",finish:"完成"},referencePicker:{title:"上传图片",description:"当前仅支持上传普通图片素材。",limitReached:"最多可上传 {{maxImages}} 张图片。",uploadImage:"点击上传图片",uploadStatus:{pending:"待上传",uploading:"上传中",uploaded:"已上传",failed:"上传失败"},removeAsset:"删除素材",retryUpload:"重新上传",done:"完成"},imageUploadPicker:{hint:"点击选择图片",uploading:"图片上传中..."},asset