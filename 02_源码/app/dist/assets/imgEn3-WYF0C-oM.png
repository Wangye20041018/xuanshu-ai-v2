Risk:"システム設定、権限、またはダウンロード後の実行に関わるため常に高リスクとして扱われます。",fileCommands:"これらのコマンドが組み込みまたはカスタムの保護ディレクトリを対象にすると直ちに遮断されます。",wrappers:"ラッパーコマンドは内部の実コマンドまで展開して検査するため、回避には使えません。",systemPaths:"これらの Windows システムディレクトリは既定で保護されます。"},ruleGroups:{destructive:"破壊的コマンド",delete:"削除系",move:"移動と名前変更",write:"書き込みと上書き",permissions:"権限と属性変更",registry:"レジストリ変更",services:"サービスとプロセス制御",network:"ネットワークとファイアウォール",disk:"ディスクとブート設定",downloadExecute:"ダウンロードして実行",wrappers:"コマンドラッパー"},protectedPaths:{label:"カスタム保護ディレクトリ",description:"自分のワークスペース、リポジトリ、または機密フォルダを遮断対象に追加できます。",addFolder:"フォルダを追加",dedupeHint:"親フォルダは子フォルダを自動的に含むため、重複ルールは作成されません。",empty:"カスタム保護ディレクトリはまだありません。",added:"保護ディレクトリを追加しました",addFailed:"保護ディレクトリの追加に失敗しました",removed:"保護ディレクトリを削除しました",duplicateIgnored:"そのディレクトリはすでに保護されています",removeAria:"保護ディレクトリ {{path}} を削除"}},agentMemoryReadonly:{cardTitle:"エージェント記憶",cardDescription:"エージェントごとの人格と記憶に関連するMarkdownファイルを表示",memoryToggle:{label:"内蔵 Memory",description:'無効にすると openclaw.json に plugins.slots.memory = "none" を書き込みます。',enabledSuccess:"内蔵 memory を有効化しました",disabledSuccess:"内蔵 memory を無効化しました",loadFailed:"内蔵 memory 状態の読み込みに失敗しました",saveFailed:"内蔵 memory 状態の更新に失敗しました"},openDialog:"記憶の詳細を開く",dialogTitle:"エージェント記憶の詳細",dialogDescription:"ポップアップでエージェントごとの設定、コアドキュメント、日次ログを表示",title:"エージェント記憶読み取り専用パネル",description:"デフォルトでは折りたたまれています。展開してエージェントを切り替え、設定と記憶ドキュメントを表示します",expand:"展開",collapse:"折りたたむ",agentListTitle:"エージェントリスト",agentListDescription:"openclaw.jsonの順序で表示",overviewTitle:"エージェント設定概要",coreDocsTitle:"コアドキュメント",dailyLogsTitle:"日次ログ",loading:{bundle:"エージェントドキュメントを読み込み中..."},states:{exists:"読み取り可能",missing:"欠落（空）",pending:"生成待ち"},empty:{noAgents:"利用可能なエージェントが見つかりません。openclaw.jsonを確認してください。",noDailyLogs:"このエージェントの日次ログファイルはありません。"},errors:{loadAgentList:"エージェントリストの読み込みに失敗しました",loadAgentBundle:"エージェントドキュメントの読み込みに失敗しました"},labels:{agentId:"エージェントID",workspace:"ワークスペース",model:"モデル",sandboxMode:"サンドボックスモード",toolsAllowCount:"許可されたツール数",toolsDenyCount:"拒否されたツール数",notSet:"未設定"},docDescriptions:{identity:"エージェント名、アバター、絵文字などの身元情報を記録します。",soul:"エージェントの人格、口調、境界線、行動スタイルを定義します。",agents:"エージェントの実行仕様と作業制約を定義します。",user:"ユーザープロファイル、好み、対話の慣例を記録します。",tools:"ツールの使用戦略、制限、ベストプラクティスを記録します。",memory:"長期的なコア記憶。安定した事実と重要な決定を保存します。"},hints:{memoryNotYetCreated:"会話中に自動生成されます。エージェントとチャットして記憶を構築してください。",dailyLogsAutoCreated:"エージェントが会話の要点を記録する際に自動作成されます。"}}},channels:{health:{reasons:{gateway_recovering:"ゲートウェイは直近の RPC タイムアウトから復旧中です。",gateway_application_stuck:"ゲートウェイ接続は維持されていますが、重要なランタイム RPC が応答していません。"}},dialog:{feishuModeBadge:"QR作成 / 手動連携",retryCreateBot:"QRコードを再生成",createFeishuBot:"Feishu ボットを新規作成",feishuExistingDescription:"このアカウントに紐付いた現在の Feishu ボット設定を確認し、更新します。",feishuExistingHelpTitle:"現在のボット設定",feishuCreateDescription:"公式の QR フローで新しい Feishu ボットを作成し、生成された認証情報をアプリに自動反映します。",feishuCreateInstructions:["「Feishu ボットを新規作成」を選び、下のボタンから QR コードを生成します","Feishu クライアントで QR コードを読み取り、公式のボット作成フローを完了します","作成が成功すると、アプリが App ID / App Secret を保存してチャンネル状態を更新します","すでに App ID / App Secret がある場合は、「既存ボットを連携」に切り替えてください"],feishuModes:{create:{title:"Feishu ボットを新規作成",description:"QR コードで新しい Feishu ボットを作成し、自動で接続します。"},manual:{title:"既存ボットを連携",description:"既存の App ID / App Secret を入力し、現在の手動設定フローを使います。"}},feishuCreateStates:{waiting_scan:"Feishu でスキャンしてボットを作成してください",creating_bot:"スキャン済みです。ボットを作成しています...",applying_config:"Feishu 設定を書き込んでいます...",restarting:"チャンネル接続を更新しています...",completed:"作成が完了しました。チャンネル状態を更新しています...",failed:"作成に失敗しました。もう一度お試しください。"},feishuHelpModes:{create:{summary:"QR コードをスキャンして新しい Feishu ボットを作成すると、アプリが生成された認証情報を自動反映します。"},manual:{summary:"すでに App ID と App Secret がある場合は、このモードで既存ボットを連携します。"}},feishuHelpExisting:{summary:"このページでは現在のボット設定のみを管理します。別の Feishu ボットを作成する場合は、Channel 一覧に戻って新しいアカウントを追加してください。"},qqbotModeBadge:"QR作成 / 手動連携",createQQBotBot:"QQ ボットを新規作成",qqbotCreateDescription:"公式の QR フローで新しい QQ ボットを作成/バインドし、生成された認証情報をアプリに自動反映します。",qqbotCreateInstructions:["「QQ ボットを新規作成」を選び、下のボタンから QR コードを生成します","QQ モバイルアプリで QR コードを読み取り、公式のバインドフローを完了します","バインドが成功すると、アプリが App ID / Client Secret を保存してチャンネル状態を更新します","すでに App ID / Client Secret がある場合は、「既存ボットを連携」に切り替えてください"],qqbotModes:{create:{title:"QQ ボットを新規作成",description:"QR コードで新しい QQ ボットを作成/バインドし、自動で接続します。"},manual:{title:"既存ボットを連携",description:"既存の App ID / Client Secret を入力し、現在の手動設定フローを使います。"}},qqbotCreateStates:{waiting_scan:"QQ でスキャンしてボットをバインドしてください",creating_bot:"スキャン済みです。ボットをバインドしています...",completed:"バインドが完了しました。チャンネル状態を更新しています...",failed:"バインドに失敗しました。もう一度お試しください。"},qqbotHelpModes:{create:{summary:"QR コードをスキャンして新しい QQ ボットを作成/バインドすると、アプリが生成された認証情報を自動反映します。"},manual:{summary:"すでに App ID と Client Secret がある場合は、このモードで既存ボットを連携します。"}}},meta:{feishu:{description:"WebSocket 経由で Feishu/Lark ボットに接続します",instructions:["ドキュメントを読み、Feishu Open Platform に移動します","新しいアプリケーションを作成します","App ID と App Secret を取得します","イベントとコールバックで購読方式を長リンクにし、少なくともメッセージ受信とカード操作イベントを追加します","保存後にボット設定を完了し、Feishu アプリのバージョンを公開します"]}}},videoWorkbench:{header:{badge:"Video Workbench",title:"AI 動画ワークベンチ",pageTitle:"AI動画生成",generationQueue:"生成キュー",newTask:"新しいタスク",history:"履歴"},navigation:{label:"クイック移動",currentDraft:"現在のドラフト",runningTask:"実行中のタスク"},inspiration:{title:"動画制作を始めて、アイデアをすぐ形に",description:"まずはプリセットのプロンプトを選び、その下で素材、比率、長さ、カメラ表現を調整します。",presetLabel:"プリセットプロンプト",expand:"プリセットをもっと見る",collapse:"プリセットをたたむ",compactHint:"上部でタスクが進行中です。必要なら展開して別のプリセットへ切り替えられます。"},presetCards:{cyberpunkCity:{title:"サイバー・モト",subtitle:"SFスピード / チェイス",prompt:"8K超高精細、60fpsのサイバーパンク追走ショット。鋭い金属ボディにネオン光、車輪は青紫の光跡を引き、メーターのホログラムが点滅する。ライダーはハイテクなグリッド街路を疾走し、路面には光の波紋が流れ、ヘッドライトが夜を切り裂く。カメラは車体に密着して高速追従し、モーションブラーと粒子エフェクトで速度感を強調。両側のホログラム広告と冷たい建築が圧迫感を演出。運鏡は滑らかで揺れなし、反射は物理に忠実、ループなし。主体と車体構造は完全に一貫し、変形・貫通・透かしなし。"},wuxiaAction:{title:"武侠の雨戦",subtitle:"物語アクション / 豪雨の群戦",prompt:"8K超高精細、60fpsの映画級武侠。豪雨の江南古街、溜まり水が暖色の灯りを映す。黒金の鎧の侠客が屋根から敵陣へ跳び込み、雨を裂く剣で斬撃と受け流し、着地して回転しながら連続で数人を退ける。水しぶきと衣の動きは物理法則に厳密。高所俯瞰から中景へプッシュインし、刃のクローズアップを回り込み、素早い押し引きで群戦を見せ、最後はゆっくり引いて納刀する背中で固定。ループなし、次世代PBR写実、雨のゴッドレイと冷たい光影。主体は完全一致、変形・貫通・透かしなし。"},productShowcase:{title:"商業製品CM",subtitle:"高級質感 / プロダクトフィルム",prompt:"8K超高精細、60fpsのプレミアム商品CM。画面中央に洗練された製品、ラベルは鋭く鮮明で、高反射のダークステージ上に配置。微細な物理振動とともに光の波が反射面を揺らぐ。背景では抽象的なエネルギー光線が交差し、期待感を醸成。側面から高速に寄ってマクロ特写で素材の透明感と強い輪郭を際立たせ、その後ゆっくり引いて全体の存在感を見せる。柔光と硬光を精密に切り替え、濃厚で正確な色彩（色かぶりなし）。主体は中央で安定、ループなし、透かしなし。"},natureBreeze:{title:"海岸ドローン",subtitle:"自然風景 / 没入航撮",prompt:"8K超高精細、60fpsの没入型ドローン映像。重い雲から急降下し、草坡の野花と黒い崖をかすめ、壮大な北欧の海岸へ迫る。崖縁を歩く人影、群れのカモメがレンズ前を横切り、波が岩肌を激しく打ち、草葉が風に揺れる。雲間からゴッドレイが差し、光影が地形に沿って素早く流れ、強い明暗対比で迫力を出す。運鏡は終始スムーズで引っかかりなし。ループなし、歪みなし、色は自然で、叙情的かつ自由な空気感を表現。"}},composer:{none:"なし",promptPlaceholder:"アイデアを入力してください。",context:{title:"現在の制作コンテキスト",agent:"拡写 · {{agent}}",model:"モデル · {{model}}",references_one:"参照素材 {{count}} 件",references_other:"参照素材 {{count}} 件",frames_one:"キーフレーム {{count}} 件",frames_other:"キーフレーム {{count}} 件",uploadingAssets_one:"アップロード中 {{count}} 件",uploadingAssets_other:"アップロード中 {{count}} 件",failedAssets_one:"アップロード失敗 {{count}} 件",failedAssets_other:"アップロード失敗 {{count}} 件",expandReady:"直前の拡写を戻せます",expandStale:"拡写後に文面が変更されました"},actions:{upload:"アップロード",referenceAsset:"素材を参照",history:"履歴",revertExpand:"拡写を元に戻す",expanding:"拡写中...",expand:"インスピレーション拡写",moreControls:"詳細コントロール",lessControls:"詳細をたたむ",generating:"生成中...",loadingModels:"モデル読み込み中...",generate:"生成"},fields:{videoModel:"動画モデル",aspectRatio:"比率",duration:"長さ"},model:{loading:"動画モデルを読み込み中...",noModels:"利用可能な動画モデルがありません",missing:"モデル未選択",available_one:"利用可能な動画モデルは {{count}} 件です",available_other:"利用可能な動画モデルは {{count}} 件です"},status:{saving:"ドラフトを保存中..."},capability:{images_one:"画像 {{count}} / {{max}}",images_other:"画像 {{count}} / {{max}}",videos_one:"動画 {{count}} / {{max}}",videos_other:"動画 {{count}} / {{max}}",audios_one:"音声 {{count}} / {{max}}",audios_other:"音声 {{count}} / {{max}}",duration:"最大 {{max}}s"},referenceMenu:{empty:"参照する前に素材をアップロードしてください。"},agent:{currentAgentTitle:"現在の拡写 Agent: {{agent}}",selectAgentTitle:"拡写 Agent を選択: {{agent}}",menuTitle:"拡写 Agent",noAgents:"利用可能な planner agent がありません。AI LLM / ローカルフォールバックを自動的に使用します。"}},agent:{autoSelect:"自動選択",autoSelectHint:"まず video-planner を試し、無ければ AI LLM とローカル計画にフォールバックします。"},auth:{